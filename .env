# LIVE PRODUCTION API.
#
# This is not a local copy. Every edit, approval, rejection and delete in this UI
# happens to the real system.
#
# To work against the local dev backend instead, comment this line out and
# restart the dev server; the app falls back to http://127.0.0.1:8000/api/v1,
# which is a separate SQLite database with only seeded fixture data in it.
VITE_API_BASE_URL=https://icpc.glanzly-service.de/api/v1
